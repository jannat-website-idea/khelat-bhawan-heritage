{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/studio/:match*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/((?!api/|studio|static/|assets/|images/|Videos/).*)",
      "destination": "/index.html"
    }
  ]
}
